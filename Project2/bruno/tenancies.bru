meta {
  name: Tenancies returns three items
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/tenancies
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("returns three tenancies", function() {
    expect(res.getBody().length).to.equal(3);
  });

  test("each tenancy has an id, number and tenant", function() {
    res.getBody().forEach(function(t) {
      expect(t).to.have.property("id");
      expect(t).to.have.property("tenancyNumber");
      expect(t).to.have.property("tenant");
    });
  });
}
